{
  "name": "openchaos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "npm run wasm:build",
    "build": "next build",
    "prebuild": "npm run wasm:build",
    "start": "next start",
    "lint": "eslint",
    "wasm:build": "cd rust/openchaos_wasm && rustup run stable wasm-pack build --target web --out-dir ../../src/wasm/pkg && mkdir -p ../../public/wasm/pkg && cp ../../src/wasm/pkg/* ../../public/wasm/pkg/",
    "wasm:build:release": "cd rust/openchaos_wasm && wasm-pack build --target web --release --out-dir ../../src/wasm/pkg",
    "wasm:dev": "cd rust/openchaos_wasm && cargo watch -s 'wasm-pack build --target web --out-dir ../../src/wasm/pkg'",
    "wasm:test": "cd rust/openchaos_wasm && cargo test"
  },
  "dependencies": {
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
