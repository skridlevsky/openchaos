{
  "name": "openchaos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "predev": "node ./scripts/copy-wasm.js",
    "build": "next build",
    "prebuild": "node ./scripts/copy-wasm.js",
    "postinstall": "node ./scripts/copy-wasm.js",
    "start": "next start",
    "lint": "eslint",
    "wasm:build": "PATH=\"$HOME/.cargo/bin:$PATH\" wasm-pack build rust/openchaos_wasm --target web --out-dir ../../src/wasm/pkg"
  },
  "dependencies": {
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}